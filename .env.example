# ════════════════════════════════════════════════════════════
# PayFlow Payment Orchestration — Environment Configuration
# Copy to .env and fill ALL values before running.
# ════════════════════════════════════════════════════════════

APP_NAME=PayFlow Payment Orchestration
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# API key used only in development
API_KEY=CHANGE_ME_WITH_A_RANDOM_SECURE_STRING

# ── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://payflow:payflow@localhost:5432/payflow
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ──────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ══════════════════════════════════════════════════════════════
# RAZORPAY
# Obtain from Razorpay Dashboard
# ══════════════════════════════════════════════════════════════
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# ══════════════════════════════════════════════════════════════
# STRIPE
# Obtain from Stripe Dashboard
# ══════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# ══════════════════════════════════════════════════════════════
# PAYU
# Obtain from PayU Dashboard
# ══════════════════════════════════════════════════════════════
PAYU_MERCHANT_KEY=YOUR_PAYU_MERCHANT_KEY
PAYU_MERCHANT_SALT=YOUR_PAYU_MERCHANT_SALT
PAYU_WEBHOOK_SECRET=YOUR_PAYU_WEBHOOK_SECRET

PAYU_SUCCESS_URL=https://your-domain.com/payment/success
PAYU_FAILURE_URL=https://your-domain.com/payment/failure

# ══════════════════════════════════════════════════════════════
# PHONEPE
# Obtain from PhonePe Developer Portal
# ══════════════════════════════════════════════════════════════
PHONEPE_MERCHANT_ID=YOUR_PHONEPE_MERCHANT_ID
PHONEPE_SALT_KEY=YOUR_PHONEPE_SALT_KEY
PHONEPE_SALT_INDEX=1

UPI_REDIRECT_URL=https://your-domain.com/payment/upi/redirect
UPI_CALLBACK_URL=https://your-domain.com/api/v1/webhooks/upi

# ── Circuit Breaker ─────────────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_SUCCESS_THRESHOLD=2
CB_TIMEOUT_SECONDS=30

# ── Routing Weights (must sum to 1.0) ───────────────────────
ROUTING_WEIGHT_SUCCESS=0.35
ROUTING_WEIGHT_LATENCY=0.20
ROUTING_WEIGHT_COST=0.20
ROUTING_WEIGHT_HEALTH=0.15
ROUTING_WEIGHT_FIT=0.10

# ── Gateway Timeouts ────────────────────────────────────────
GATEWAY_CONNECT_TIMEOUT=5.0
GATEWAY_READ_TIMEOUT=30.0
FAILOVER_TIMEOUT_SECONDS=2.0

# ── Observability ───────────────────────────────────────────
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true

# Optional OpenTelemetry Collector
# OTLP_ENDPOINT=http://otel-collector:4317